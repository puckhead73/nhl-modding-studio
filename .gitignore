# ---- Game data & user artifacts (NEVER commit copyrighted EA data) ----
# Real game databases, saves, and extracted assets must stay out of the repo.
/sample-data/real/
*.tdb
*.db
*.viv
*.bh
*.sav
*.roster
fixtures/private/

# ---- Anchors: vanilla EA databases + saves shipped WITH the tool as the clean-slate baseline.
#      COMMITTED per user decision 2026-06-26 (this is data shipped with the tool, not proprietary
#      code — overrides the broad EA-data patterns above for this path only). Stored as plain git
#      binaries (all files are small; git's own packing compresses them). Re-include despite the
#      *.db etc. patterns above.
!/anchors/
!/anchors/**

# ---- Staging: transient review area. Contents are unverified until checked against anchors and
#      promoted into docs/. Not tracked.
/Staging/
